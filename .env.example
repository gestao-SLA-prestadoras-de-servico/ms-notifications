# Exemplos locais; configure estes valores no ambiente antes de iniciar.
SERVER_PORT=8081
DB_URL=jdbc:postgresql://localhost:15432/ms_notificacoes
DB_USERNAME=usuario_do_servico
DB_PASSWORD=substitua_por_uma_senha
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5673
RABBITMQ_USERNAME=usuario_do_servico
RABBITMQ_PASSWORD=substitua_por_uma_senha
RABBITMQ_VHOST=/
MAIL_HOST=localhost
MAIL_PORT=11025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=notificacoes@flowsla.local
MAIL_SMTP_AUTH=false
MAIL_STARTTLS_ENABLED=false
MAIL_CONNECTION_TIMEOUT_MS=5000
MAIL_READ_TIMEOUT_MS=5000
MAIL_WRITE_TIMEOUT_MS=5000
SMTP_CIRCUIT_BREAKER_ENABLED=true
SMTP_CIRCUIT_WINDOW_SIZE=1
SMTP_CIRCUIT_MIN_CALLS=1
SMTP_CIRCUIT_FAILURE_RATE=100
SMTP_CIRCUIT_OPEN_WAIT=30s
SMTP_PROBE_INTERVAL=5s
CONSUMIDOR_EMAIL_ENABLED=true
NOTIFICACOES_FILA_EMAIL=notificacoes.email
PROCESSAMENTO_LOCK_TIMEOUT=10s
RETRY_INITIAL_INTERVAL_MS=1000
RETRY_MULTIPLIER=2
RETRY_MAX_INTERVAL_MS=30000
RETRY_CONFIRM_TIMEOUT_MS=5000
NOTIFICACOES_RETRY_EXCHANGE=notificacoes.retry
NOTIFICACOES_DLX=notificacoes.dlx
CONSUMIDOR_INTERNO_ENABLED=true
NOTIFICACOES_FILA_INTERNA=notificacoes.interna

# Docker Compose: portas no host; endereços internos são definidos no compose.yaml.
# Copie para .env e substitua as senhas. O Compose carrega .env automaticamente.
POSTGRES_LOCAL_PORT=15432
RABBITMQ_LOCAL_PORT=5673
RABBITMQ_MANAGEMENT_LOCAL_PORT=15673
MAIL_SMTP_LOCAL_PORT=11025
MAIL_UI_LOCAL_PORT=18025
